# Application
APP_NAME=ai-agent-poc
ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent_poc

# LLM (agent orchestrator)
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
# Depuis le conteneur docker-compose "api", Ollama tourne sur la machine hote :
# utiliser http://host.docker.internal:11434 (deja configure dans docker-compose.yml).
# En local sans Docker : http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Connecteur GitHub Issues
GITHUB_TOKEN=

# Envoi d'email (Resend ou SendGrid)
EMAIL_API_KEY=
EMAIL_FROM=

# Authentification API (Epic 7, bonus)
API_KEY=

# Embeddings (Epic 1 — RAG)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_MAX_TOKENS=200
RAG_CHUNK_OVERLAP=20
RAG_SIMILARITY_THRESHOLD=0.2
