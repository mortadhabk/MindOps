# Application
APP_NAME=ai-agent-poc
ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=false

# Database
# Port hote 5442 (le conteneur ecoute toujours en interne sur 5432, voir docker-compose.yml) :
# evite un conflit si un Postgres natif (hors Docker) occupe deja le port 5432 standard.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5442/ai_agent_poc

# LLM (agent orchestrator) — valeurs de DEMARRAGE seulement (Epic 9, interface-first) : une fois
# configure depuis l'onglet Parametres (fournisseur, modele, URL, cle API), c'est cette
# configuration en base (chiffree) qui prevaut, plus besoin de toucher ce fichier ni de
# redemarrer. Ces 3 valeurs ne servent qu'au tout premier demarrage, avant toute sauvegarde UI.
LLM_PROVIDER_KIND=ollama
LLM_MODEL=llama3.1:8b
# Depuis le conteneur docker-compose "api", Ollama tourne sur la machine hote :
# utiliser http://host.docker.internal:11434 (deja configure dans docker-compose.yml).
# En local sans Docker : http://localhost:11434
LLM_BASE_URL=http://localhost:11434

# Cle de chiffrement (Fernet) pour les secrets saisis depuis l'onglet Parametres (ex: cle API
# d'un modele distant type Kimi/DeepSeek/GPT/Claude) — le seul secret encore requis dans .env,
# tout le reste se configure desormais depuis l'interface. Generer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Connecteur GitHub Issues
GITHUB_TOKEN=

# Connecteur SharePoint (Microsoft Graph API, application "client credentials") — nécessite une
# App Registration Azure AD (portail Azure > Azure Active Directory > App registrations) avec :
#   - une permission d'application (pas déléguée) Sites.Selected (recommandé : accès limité au(x)
#     site(s) explicitement autorisé(s), voir README) ou Sites.Read.All (plus large, plus simple) ;
#   - un secret client généré (Certificates & secrets > New client secret) ;
#   - le consentement admin donné sur la permission (bouton "Grant admin consent").
# Avec Sites.Selected, un administrateur doit en plus autoriser explicitement le site cible :
#   PUT https://graph.microsoft.com/v1.0/sites/{site-id}/permissions
#   { "roles": ["read"], "grantedToIdentities": [{"application": {"id": "{client-id}", ...}}] }
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Connecteur Jira (Epic 10) — deux jeux d'identifiants distincts selon deployment_type :
#   - Jira Cloud (*.atlassian.net) : email + API token, generes sur
#     https://id.atlassian.com/manage-profile/security/api-tokens
#   - Jira Server / Data Center (interne) : Personal Access Token, genere sur
#     {base_url}/secure/ViewProfile.jspa > Personal Access Tokens
JIRA_CLOUD_EMAIL=
JIRA_CLOUD_API_TOKEN=
JIRA_SERVER_TOKEN=

# Envoi d'email — sandbox Mailtrap (Email Testing) par défaut : e-mails capturés dans une
# boîte fictive, jamais réellement délivrés. Voir mailtrap.io/inboxes > Integration > API.
# EMAIL_API_KEY = le token API (onglet "Integration" > "API"), pas le mot de passe SMTP.
EMAIL_API_KEY=
EMAIL_FROM=
MAILTRAP_INBOX_ID=

# Politique de confiance (Epic 4 — gating). Une entrée par type d'action (nom du Tool) :
# "suggest_only" | "require_validation" | "auto_execute". Basculer send_email en auto_execute
# ici, sans toucher au code, est la démonstration clé du projet (US-406).
GATING_POLICY={"send_email": "require_validation"}
GATING_MIN_CONFIDENCE=0.8

# Authentification API (Epic 7, bonus)
API_KEY=

# Embeddings (Epic 1 — RAG)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_MAX_TOKENS=200
RAG_CHUNK_OVERLAP=20
RAG_SIMILARITY_THRESHOLD=0.2

# Reranking (cross-encoder) : reordonne les resultats de la recherche vectorielle avant de les
# renvoyer, plus precis qu'une similarite cosinus seule. Desactivable depuis Parametres > RAG
# (rag_rerank_enabled) sans toucher a .env.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANK_ENABLED=true
